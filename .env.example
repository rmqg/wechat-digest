# Copy to .env and set a strong password; this file never logs in to WeChat for you.
DESKTOP_PASSWORD=
DESKTOP_USER=operator
DESKTOP_BIND=127.0.0.1
DESKTOP_PORT=3000
DESKTOP_SHM_SIZE=1gb
WECHAT_DESKTOP_IMAGE=ghcr.io/nickrunning/wechat-selkies:0.0.12-minimal
WECHAT_DESKTOP_CONTAINER=wechat-digest-desktop
WECHAT_RUNTIME_IMAGE=wechat-digest-runtime:1.0.0
PUID=1000
PGID=1000
TZ=Asia/Shanghai
